# Firo backend — example environment. Copy to .env and fill in.
# NEVER commit a real .env (see .gitignore).

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public base path for the API (used for absolute links). No trailing slash.
API_BASE_URL=http://localhost:3000

# --- The following are placeholders for future phases (not required yet) ---
# DATABASE_URL=postgres://firo:firo@localhost:5432/firo
# REDIS_URL=redis://localhost:6379
# JWT_ISSUER=firo.auth
# JWT_AUDIENCE=firo.api

# --- Database (docker compose) ---
POSTGRES_USER=firo
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=firo
# The API builds DATABASE_URL from the above when using docker compose.
# Running the API outside compose? Set it directly:
# DATABASE_URL=postgres://firo:password@127.0.0.1:5432/firo
DB_POOL_MAX=10
DB_AUTO_MIGRATE=true

# --- Admin console ---
# Comma-separated emails that receive the admin role WHEN THEY REGISTER.
# A bootstrap, not an access-control list: it cannot promote an existing
# account, and every promotion after the first goes through the console
# (audited) or `pnpm admin:grant <email>` on the server.
# See docs/ADMIN-CONSOLE.md.
ADMIN_EMAILS=

# --- Media (images) ---
# Where uploads are stored. With docker compose this is a volume mount.
MEDIA_DIR=./var/media
# The PUBLIC prefix images are served from. This is written into the database
# when a photo is attached to a card, so set it before uploading anything and
# do not change it afterwards. Empty = this API serves them at /media.
#   production: https://api.yourdomain.com/media
MEDIA_BASE_URL=
# Per-file cap. Every byte here is bandwidth on every view.
MEDIA_MAX_UPLOAD_BYTES=26214400
# Uploads stop below this much free disk, so images can never starve Postgres
# of the room it needs to write.
MEDIA_MIN_FREE_BYTES=2147483648
