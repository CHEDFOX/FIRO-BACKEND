# Firo backend — example environment. Copy to .env and fill in.
# NEVER commit a real .env (see .gitignore).

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public base path for the API (used for absolute links). No trailing slash.
API_BASE_URL=http://localhost:3000

# --- The following are placeholders for future phases (not required yet) ---
# DATABASE_URL=postgres://firo:firo@localhost:5432/firo
# REDIS_URL=redis://localhost:6379
# JWT_ISSUER=firo.auth
# JWT_AUDIENCE=firo.api

# --- Database (docker compose) ---
POSTGRES_USER=firo
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=firo
# The API builds DATABASE_URL from the above when using docker compose.
# Running the API outside compose? Set it directly:
# DATABASE_URL=postgres://firo:password@127.0.0.1:5432/firo
DB_POOL_MAX=10
DB_AUTO_MIGRATE=true
